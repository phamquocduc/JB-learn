# Django Core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<your-space>.hf.space

# MySQL / TiDB Database
MYSQL_DATABASE=JB_db
MYSQL_USER=root
MYSQL_PASSWORD=your-db-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_SSL=False

# CORS & CSRF
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<your-app>.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.koyeb.app,https://*.vercel.app

# Whisper Model (base for local, tiny for 512MB RAM cloud free tier)
WHISPER_MODEL_SIZE=tiny

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-folder
CLOUDINARY_API_KEY=your-cloudinary-numeric-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@dhyay1hbw

# Groq Whisper Cloud API (Speech-to-Text with Whisper Large v3, zero server RAM)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional Proxy for YouTube transcript scraping on Cloud servers (Residential / Datacenter proxy)
# YOUTUBE_PROXY=http://username:password@proxy-host:port
